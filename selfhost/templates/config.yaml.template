# StackChan 服务端配置（由 render.py 生成，不要手改）
# 源：selfhost/templates/config.yaml.template + selfhost/deploy.env
# 手改会在下次 render 时被覆盖。

server:
  ip: 0.0.0.0
  port: 8000
  http_port: 8003
  # 设备访问的地址；由 DEVICE_HOST 派生
  websocket: ws://${DEVICE_HOST}:8000/xiaozhi/v1/
  vision_explain: http://${DEVICE_HOST}:8003/mcp/vision/explain
  timezone_offset: ${TZ_OFFSET}
  auth:
    enabled: ${AUTH_ENABLED}
    allowed_devices: ${ALLOWED_DEVICES_YAML}

log:
  log_level: ${LOG_LEVEL}

# 音频 / 调试
delete_audio: true
debug_opus_dump: false
close_connection_no_voice_time: 60
disable_device_mcp_tools: true

# 语音会话参数：必须与设备 hello 声明一致（设备硬编码 16000）。
# 缺这段会合并镜像默认 24000 → 服务端按 24k 合成却告诉设备 16k，声音断续。
xiaozhi:
  audio_params:
    sample_rate: 16000
    format: opus
    channels: 1
    frame_duration: 60

# 人设
prompt: |
${PERSONA_INDENTED}

# 系统提示词模板；render.py 会把 templates/agent-base-prompt.txt 复制到 data/
prompt_template: /opt/xiaozhi-esp32-server/data/agent-base-prompt.txt

system_error_response: "我这会儿有点走神，你再说一次好不好？"

end_prompt:
  enable: true
  # 预生成音频 assets/end_prompt.wav；改文案要重新生成
  text: "${END_PROMPT_TEXT}"
  prompt: |
    请你以"时间过得真快"为开头，用富有感情、依依不舍的话来结束这场对话吧！

selected_module:
  VAD: SileroVAD
  ASR: FunASR
  LLM: DeepSeekLLM
  # VLLM 不覆盖，继承镜像默认；视觉问答需要自己配 key
  TTS: EdgeTTS
  Memory: ${MEMORY}
  Intent: function_call

# 意图识别：function_call 下必须显式列出要加载的工具。
# 缺这段会合并镜像默认值（web_search=metaso 占位 key、play_music、热榜新闻），
# 我们的 deepsearch 不会被注册——2026-11-15 就是这样丢的联网搜索。
Intent:
  nointent:
    type: nointent
  intent_llm:
    type: intent_llm
    llm: ChatGLMLLM
    functions:
      - web_search
      - get_weather
      - get_news_from_newsnow
      - play_music
  function_call:
    type: function_call
    functions:
      # 只保留这两个；get_news_from_newsnow 会抢「新闻」类查询但只回热榜，
      # 质量不如 deepsearch（2026-11-09 定）
      - deepsearch
      - get_weather
      # 番茄钟语音设置：LLM -> 函数 -> behavior /api/timers -> 设备 timer_start
      - start_pomodoro
      - stop_pomodoro

VAD:
  SileroVAD:
    type: silero
    threshold: 0.5
    threshold_low: 0.3
    model_dir: models/snakers4_silero-vad
    # 判停静默阈值。上游示例是 200ms，会把句中逗号级停顿当成说完
    # （中文自然停顿 400–800ms）。500ms 兼顾长句完整与响应速度。
    min_silence_duration_ms: 500

ASR:
  FunASR:
    type: fun_local
    model_dir: models/SenseVoiceSmall
    output_dir: tmp/
    # auto 会把中文短句误判成韩文；固定 zh
    language: zh

LLM:
  DeepSeekLLM:
    type: openai
    model_name: ${LLM_MODEL}
    base_url: ${LLM_BASE_URL}
    api_key: ${LLM_API_KEY}
    temperature: ${LLM_TEMPERATURE}
    max_tokens: ${LLM_MAX_TOKENS}
    # LLM 卡住时不要干等；read=15s 是 chunk 之间的上限
    timeout:
      pool: 2
      connect: 5
      write: 10
      read: 15
    max_retries: 1

TTS:
  EdgeTTS:
    type: edge
    voice: ${TTS_VOICE}
    # 整段合成：LLM 全文到齐后只调一次 TTS
    batch_mode: true
    # 流式：边收边编码
    stream_mode: true
    output_dir: tmp/

plugins:
  get_weather:
    api_host: "${QWEATHER_API_HOST}"
    api_key: "${QWEATHER_API_KEY}"
    default_location: "${DEFAULT_CITY}"
  deepsearch:
    # 留空 = 复用 LLM.DeepSeekLLM.api_key
    api_key: ""
    count: 6
  pomodoro:
    # xiaozhi 容器 -> 宿主机 behavior 服务的内部地址。
    # 容器里不要用 Tailscale 公网地址；OrbStack/Docker Desktop 用 host.docker.internal。
    base_url: "${BEHAVIOR_INTERNAL_URL}"
    # 与 behavior/.env 的 APP_TOKEN 一致；由 render 从 deploy.env 注入。
    app_token: "${APP_TOKEN}"
    timeout: 5
