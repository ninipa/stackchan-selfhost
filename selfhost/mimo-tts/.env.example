# 复制成 .env 后填入真实值（.env 已 gitignore）
MIMO_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：默认音色（冰糖 / 茉莉 / 苏打 / 白桦）
MIMO_VOICE=冰糖

# 可选：接口地址与模型
# MIMO_API_URL=https://api.xiaomimimo.com/v1/chat/completions
# MIMO_MODEL=mimo-v2.5-tts

# 可选：监听地址（容器通过 host.docker.internal 访问，必须 0.0.0.0）
# MIMO_BIND=0.0.0.0
# MIMO_PORT=8899
