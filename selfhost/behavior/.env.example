# 开发用示例（复制成 .env；生产建议用 selfhost/deploy.env + render-config.sh 生成）
PUBLIC_BASE_URL=http://192.168.1.20:8100

# 开发环境允许短 token；生产必须设 0
DEVICE_TOKEN=dev-device-token
APP_TOKEN=dev-token
ALLOW_INSECURE_DEFAULTS=1

TTS_VOICE=zh-CN-XiaoyiNeural
TZ=Asia/Shanghai
DATA_DIR=/data
DEFAULT_GAP_MS=800
XIAOZHI_CONFIG=/xiaozhi-config/.config.yaml
HISTORY_KEEP=200
# 设备在线判定：超过这么多秒没收到消息（含 15s 心跳）就显示离线
DEVICE_ONLINE_TTL_SECONDS=60

# docker compose build 的变量替换（中国网络可填）
BEHAVIOR_BASE_IMAGE=
APT_MIRROR=
PIP_INDEX_URL=
