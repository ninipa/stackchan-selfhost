# StackChan 部署配置（复制成 deploy.env 后填写；deploy.env 已 gitignore）
#
# 这份文件是服务端配置的唯一真相；render-config.sh 会生成：
#   selfhost/data/.config.yaml
#   selfhost/data/agent-base-prompt.txt
#   selfhost/behavior/.env
#
# 不要直接手改生成物；下次 render 会覆盖。
# 格式：一行一个 KEY=VALUE，不支持行内注释。

# ── 网络 ─────────────────────────────────────────────

# 设备访问这台服务器的局域网地址（IP 或主机名，不带 http://、不带端口）
# 固件编译时的 CHAN_SERVER_HOST 必须与它一致。
DEVICE_HOST=__REPLACE_WITH_SERVER_LAN_IP__

# 手机访问这台服务器的地址（Tailscale HTTPS / 域名 / 局域网 IP，可带端口）
# LAN-only 时填 http://<DEVICE_HOST>:8100；Tailscale 时填 https://xxx.ts.net
PUBLIC_BASE_URL=__REPLACE_WITH_APP_BASE_URL__

# ── LLM ──────────────────────────────────────────────

# 默认 DeepSeek；任何 OpenAI **Chat Completions** 兼容端点都可以。
# 只支持 .../chat/completions（Responses / Anthropic Messages / Gemini 需要另加适配）。
# 当前官方模型 ID：deepseek-flash（便宜快）/ deepseek-v4-pro。
LLM_API_KEY=__REPLACE_WITH_DEEPSEEK_OR_OPENAI_KEY__
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500

# ── 天气（可选）──────────────────────────────────────

# 没有 key 就留空；插件会返回不可用，不影响对话。
# 申请：https://console.qweather.com/
QWEATHER_API_HOST=
QWEATHER_API_KEY=
DEFAULT_CITY=北京

# ── 语音 ─────────────────────────────────────────────

# EdgeTTS 不需要 key。换音色后要重新生成 assets/end_prompt.wav
# （见 selfhost/behavior/tools/gen_prompt_audio.py）。
TTS_VOICE=zh-CN-XiaoyiNeural

# ── 时区 ─────────────────────────────────────────────

# 留空 = 按服务器系统时区自动识别；TZ_OFFSET 留空 = 按 TZ 自动推导。
# 手动指定示例：TZ=Asia/Shanghai / TZ_OFFSET=+8（印度 +5.5）
TZ=
TZ_OFFSET=

# ── 镜像 / 构建源（可选）─────────────────────────────

# xiaozhi 镜像：留空 = 用 docker-compose.yml 里 pin 的实测 digest。
# 换官方 ghcr.io 的 tag/digest 后，必须重新验证 selfhost/patches/ 的 7 个挂载补丁。
XIAOZHI_IMAGE=

# 构建 behavior 镜像时的可选源。留空 = 官方源（pypi.org / Docker Hub）。
# 中国网络建议：
#   BEHAVIOR_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
#   APT_MIRROR=mirrors.aliyun.com
#   PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
BEHAVIOR_BASE_IMAGE=
APT_MIRROR=
PIP_INDEX_URL=

# ── Token（配置页首次保存自动生成；绕过配置页才手填）──

# 配置页保存时会用 secrets.token_hex(32) 生成 64 位值；旧固件的短 DEVICE_TOKEN 会保留。
# APP_TOKEN：App/网页访问行为服务的令牌。
# DEVICE_TOKEN：设备访问行为服务的令牌；改它要重编固件。
APP_TOKEN=__REPLACE_WITH_openssl_rand_hex_32__
DEVICE_TOKEN=__REPLACE_WITH_openssl_rand_hex_32__

# ── 功能开关 ─────────────────────────────────────────

# nomem = 不启用记忆；mem_core = 启用（会在 data/memory.json 存对话摘要）
MEMORY=nomem
LOG_LEVEL=INFO

# 行为服务默认要求 token。只在完全隔离的开发环境里设 1。
ALLOW_INSECURE_DEFAULTS=0

# 部署模式：prod（公开用户）| dev（作者自己的 mini：源码挂载 + reload）
COMPOSE_PROFILE=prod

# 服务端认证：默认关闭（只允许 LAN/tailnet）。
# 开启后设备需要绑定/激活，且要把设备 MAC 填进 ALLOWED_DEVICES。
AUTH_ENABLED=false
# 逗号分隔的设备 MAC；仅 AUTH_ENABLED=true 时有意义
ALLOWED_DEVICES=

# 结束语（预生成 wav 的文本；改文案要重新生成 wav）
END_PROMPT_TEXT=我先去待机啦，下次聊

# 人设文件（相对 selfhost/ 或绝对路径）
PERSONA_FILE=templates/persona.txt
